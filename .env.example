# HealthTrace 应用侧环境变量（复制为 .env 使用，.env 不入库）
# 本文件供第 3 步起的 FastAPI 应用读取，docker-compose 不使用它。

# 应用数据库（docker-compose 里的 db 服务，pgvector 版 PostgreSQL）
DATABASE_URL=postgresql+asyncpg://healthtrace:healthtrace@localhost:5432/healthtrace

# Redis（docker-compose 里的 cache 服务，宿主端口 6380）
REDIS_URL=redis://localhost:6380/0

# Langfuse（第 5 步在 UI 注册账号并创建项目后，填入对应公钥/私钥）
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# LLM（OpenAI 兼容接口，默认 DeepSeek；base_url/model 可切换其他兼容服务）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Router 置信度阈值（低于该值强制回落 chat 兜底）
ROUTER_CONFIDENCE_THRESHOLD=0.7
